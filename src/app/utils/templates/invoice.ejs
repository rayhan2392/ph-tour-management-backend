<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Your Travel Hero Invoice</title>
</head>
<body style="font-family: Arial, sans-serif; background-color: #f9fafb; padding: 20px;">

  <table width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
    
    <!-- Header -->
    <tr style="background-color: #0F172A;">
      <td style="padding: 20px; text-align: center; color: #ffffff;">
        <h1 style="margin: 0; font-size: 24px;">Travel Hero</h1>
        <p style="margin: 5px 0 0;">Your Booking Invoice</p>
      </td>
    </tr>

    <!-- Body -->
    <tr>
      <td style="padding: 30px;">
        <p style="font-size: 16px; color: #333;">Hello <strong><%= userName %></strong>,</p>

        <p style="font-size: 16px; color: #444;">
          Thank you for booking <strong><%= tourTitle %></strong> with Travel Hero.
          Your payment has been received and your invoice is attached below.
        </p>

        <table width="100%" cellpadding="0" cellspacing="0" style="margin: 20px 0;">
          <tr>
            <td style="padding: 8px 0; color: #555;">🧾 Transaction ID:</td>
            <td style="padding: 8px 0; color: #000;"><strong><%= transactionId %></strong></td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #555;">📅 Booking Date:</td>
            <td style="padding: 8px 0; color: #000;"><strong><%= bookingDate.toDateString() %></strong></td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #555;">👥 Guest Count:</td>
            <td style="padding: 8px 0; color: #000;"><strong><%= guestCount %></strong></td>
          </tr>
          <tr>
            <td style="padding: 8px 0; color: #555;">💳 Total Paid:</td>
            <td style="padding: 8px 0; color: #000;"><strong>$<%= totalAmount.toFixed(2) %></strong></td>
          </tr>
        </table>

        <p style="font-size: 16px; color: #333;">📎 The invoice is attached to this email as a PDF file.</p>

        <p style="font-size: 14px; color: #666;">
          If you have any questions, feel free to reply to this email. We’re always happy to help!
        </p>

        <p style="margin-top: 30px; font-size: 14px; color: #999;">– Travel Hero Team</p>
      </td>
    </tr>

    <!-- Footer -->
    <tr>
      <td style="background-color: #f1f5f9; padding: 20px; text-align: center; font-size: 12px; color: #888;">
        This is an automated email. Please do not reply directly.
      </td>
    </tr>
  </table>
</body>
</html>
